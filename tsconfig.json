{
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "types": [
      "jest",
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "src",
    "tests",
    "global.d.ts",
    "templates"
  ],
  "exclude": [
    "tests/results"
  ]
}
