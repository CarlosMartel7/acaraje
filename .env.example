# Environment variables used across this repo.
#
# Most of these belong to the *generated* Acaraje admin panel (the Next.js app produced by
# `acaraje init`), not to this CLI itself — copy this file to `.env` inside the generated
# project and fill in the sections that apply to the choices you made during `init`.
# The "acaraje-cli development" section at the bottom is for working on this CLI's own repo.

# --- Database (generated project, both ORM modes) --------------------------------------------
# Read via env("DATABASE_URL") in prisma/schema.prisma or database/schema.sql.
DATABASE_URL=

# --- Admin auth (generated project) -------------------------------------------------------------
# Login credentials for the Acaraje admin panel. No user table — this is the only account.
ACARAJE_ADMIN_USERNAME=admin
ACARAJE_ADMIN_PASSWORD=password
# Session-signing secret, at least 16 characters. Generate one with: openssl rand -base64 32
ACARAJE_AUTH_SECRET=

# --- Storage: MinIO (generated project, only if you picked "minio" for storage) ----------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=acaraje-dev

# --- Storage: Google Cloud Storage (generated project, only if you picked "gcs" for storage) ---
GCS_PROJECT_ID=
GCS_BUCKET=acaraje-dev
# Only needed to point at a non-default endpoint (e.g. the GCS emulator).
GCS_API_ENDPOINT=

# --- acaraje-cli development (this repo's own test suite, not the generated project) -----------
# Controls how `tests/logger.ts` records each generator test's output.
#   json     (default) — overwrite tests/logs/<name>.log.json with a JSON dump each run.
#   folder              — copy the real generated files into tests/results/<name>/<timestamp>/.
#   no-logs             — write nothing.
TEST_LOG_TYPE=json
